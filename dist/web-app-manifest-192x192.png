<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&family=Newsreader:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Roboto,Arial,sans-serif;color:#111;background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
.nav{display:flex;justify-content:space-between;align-items:center;max-width:1120px;margin:0 auto;padding:28px 32px}
.nav img{height:30px;display:block}.nav a.t{font-size:14px;text-decoration:none;color:#555}
.wrap{max-width:1120px;margin:0 auto;padding:0 32px}
.hero{padding:72px 32px 56px}
.eyebrow{font-family:"Roboto Mono",monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#777;margin-bottom:20px}
h1{font-size:clamp(44px,7vw,88px);font-weight:500;line-height:1.02;letter-spacing:-.03em;max-width:900px}
h1 span{font-weight:300}
.lead{font-size:19px;color:#444;max-width:680px;margin-top:28px;font-weight:300}
section{padding:72px 0;border-top:1px solid #e8e8e8}
h2{font-size:40px;font-weight:500;letter-spacing:-.02em;line-height:1.1;margin-bottom:20px}
h3{font-size:22px;font-weight:500;margin:44px 0 12px}
p.b{font-size:17px;color:#444;max-width:640px;font-weight:300}
.stage{border-radius:20px;display:flex;align-items:center;justify-content:center;min-height:300px;margin:32px 0;position:relative;overflow:hidden}
.stage.l{background:#f5f5f5}.stage.d{background:#111}
.stage img{max-width:62%;max-height:140px}
.cap{font-size:13px;color:#777;font-family:"Roboto Mono",monospace;margin-top:-16px}
ul.dl{list-style:none;margin-top:24px;max-width:640px}
ul.dl li a{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid #e8e8e8;text-decoration:none;font-size:15px}
ul.dl li a:hover{background:#fafafa}
ul.dl li span{color:#888;font-family:"Roboto Mono",monospace;font-size:13px}
ul.dl li.all a{font-weight:500}
.clear{background:#f5f5f5;border-radius:20px;min-height:340px;display:flex;align-items:center;justify-content:center;margin:32px 0}
.clear .box{position:relative;padding:72px;border:1px dashed #999;background:#fff}
.clear .box img{height:72px;display:block}
.clear .box i{position:absolute;font-family:"Roboto Mono",monospace;font-size:11px;color:#999;font-style:normal}
.row3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:32px 0}
.av{aspect-ratio:1;background:#f5f5f5;border-radius:20px;display:flex;align-items:center;justify-content:center}.av img{width:42%}
.constr{display:flex;align-items:center;justify-content:center;background:#f5f5f5;border-radius:20px;min-height:340px;margin:32px 0}
.constr .h{width:216px;height:216px;border:1px dashed #999;display:flex;align-items:center;justify-content:center;background:#fff}.constr .h img{width:72px}
.avoid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:28px}
.avoid div{border:1px solid #e8e8e8;border-radius:14px;padding:16px 18px;font-size:16px}
.avoid b{display:block;font-family:"Roboto Mono",monospace;font-size:11px;color:#c0392b;font-weight:500;letter-spacing:.06em;margin-bottom:4px}
.pal{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0;border-radius:20px;overflow:hidden;margin:28px 0;border:1px solid #e8e8e8}
.pal div{padding:90px 16px 16px;font-size:13px}.pal b{display:block;font-weight:500;font-size:14px}.pal span{font-family:"Roboto Mono",monospace;font-size:12px;opacity:.8}
.do{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:640px;margin-top:20px}
.do h4{font-family:"Roboto Mono",monospace;font-size:12px;letter-spacing:.08em;margin-bottom:8px;font-weight:500}
.do ul{list-style:none;font-size:16px}.do li{padding:6px 0;border-bottom:1px solid #eee}
.g{color:#1a7f37}.r{color:#c0392b}
.type{border:1px solid #e8e8e8;border-radius:20px;padding:36px;margin:20px 0}
.type .big{font-size:72px;line-height:1.05;letter-spacing:-.02em}
.type small{font-family:"Roboto Mono",monospace;font-size:12px;color:#777;display:block;margin-bottom:12px}
footer{padding:56px 0;border-top:1px solid #e8e8e8;font-size:14px;color:#777}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
@media(max-width:700px){.row3{grid-template-columns:1fr}.do{grid-template-columns:1fr}.clear .box{padding:32px}}
</style></head><body>
